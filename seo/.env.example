# DataForSEO API credentials
# Copy this file to seo/.env and fill in your real values.
# Get these from https://app.dataforseo.com/api-access (API Login = email, API Password)
# NOTE: seo/.env is git-ignored. NEVER commit your real credentials.

DATAFORSEO_LOGIN=your_login_email_here
DATAFORSEO_PASSWORD=your_api_password_here

# Default location/language used for keyword & SERP queries
DATAFORSEO_LOCATION_CODE=2356        # 2356 = India
DATAFORSEO_LANGUAGE_CODE=en
